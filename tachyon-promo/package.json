{
  "name": "tachyon-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "render": "remotion render Tachyon-More-You out/TACHYON-More-You-1080p60.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-bitrate=320k --concurrency=4",
    "check": "tsc --noEmit",
    "review": "node scripts/review.mjs",
    "score": "node scripts/score.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/media": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.10",
    "typescript": "^5.7.3"
  }
}
